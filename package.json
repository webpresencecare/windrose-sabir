{
  "name": "windrose-sabir",
  "version": "0.3.0",
  "private": true,
  "description": "Windrose Sabir: network admin screens, the Languages panel (Copy) and the language item block.",
  "license": "GPL-2.0-or-later",
  "scripts": {
    "build": "wp-scripts build network=./src/network/index.js editor=./src/editor/index.js language-item=./src/language-item/index.js --output-path=build",
    "start": "wp-scripts start network=./src/network/index.js editor=./src/editor/index.js language-item=./src/language-item/index.js --output-path=build",
    "lint:js": "wp-scripts lint-js src"
  },
  "devDependencies": {
    "@wordpress/scripts": "37.1.0"
  },
  "dependencies": {
    "@wordpress/a11y": "5.1.0",
    "@wordpress/api-fetch": "8.1.0",
    "@wordpress/block-editor": "20.0.0",
    "@wordpress/blocks": "17.1.0",
    "@wordpress/components": "44.0.0",
    "@wordpress/data": "11.1.0",
    "@wordpress/dataviews": "22.0.0",
    "@wordpress/editor": "16.1.0",
    "@wordpress/element": "10.1.0",
    "@wordpress/hooks": "5.1.0",
    "@wordpress/i18n": "7.1.0",
    "@wordpress/icons": "20.0.0",
    "@wordpress/plugins": "8.1.0"
  }
}
